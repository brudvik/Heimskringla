; Engine configuration file.
config_version=5

[application]

config/name="Heimskringla"
config/description="Overlevelse i vikingtid - spill-test for stor generert verden"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://assets/logo/heimskringla-ikon.png"
config/windows_native_icon="res://assets/logo/heimskringla.ico"
boot_splash/bg_color=Color(0.03, 0.03, 0.04, 1)
boot_splash/image="res://assets/logo/heimskringla-logo.png"
boot_splash/fullsize=false
boot_splash/use_filter=true

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/vsync/vsync_mode=1

[dotnet]

project/assembly_name="Heimskringla"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[rendering]

textures/default_filters/anisotropic_filtering_level=4

anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
environment/defaults/default_clear_color=Color(0.55, 0.68, 0.82, 1)

[shader_globals]

sky_horizon={
"type": "vec3",
"value": Vector3(0.68, 0.78, 0.88)
}
wind_dir={
"type": "vec2",
"value": Vector2(0.8, 0.6)
}
wind_strength={
"type": "float",
"value": 0.3
}
season_leaf_tint={
"type": "vec4",
"value": Vector4(0.85, 0.45, 0.1, 0)
}
season_conifer={
"type": "float",
"value": 0.0
}
snow_line={
"type": "float",
"value": 0.0
}
wetness={
"type": "float",
"value": 0.0
}
player_head={
"type": "vec3",
"value": Vector3(0, -10000, 0)
}
season_leaf_drop={
"type": "float",
"value": 0.0
}
world_map={
"type": "sampler2D",
"value": ""
}
world_rect={
"type": "vec4",
"value": Vector4(-5120, -5120, 9.765625e-05, 9.765625e-05)
}
sky_zenith={
"type": "vec3",
"value": Vector3(0.28, 0.5, 0.84)
}
cloud_light={
"type": "vec3",
"value": Vector3(1, 0.97, 0.94)
}
cloud_shadow={
"type": "vec3",
"value": Vector3(0.55, 0.6, 0.7)
}
cloud_params={
"type": "vec4",
"value": Vector4(0.45, 0, 0, 0)
}
cloud_offset={
"type": "vec2",
"value": Vector2(0, 0)
}
sun_direction={
"type": "vec3",
"value": Vector3(0, 1, 0)
}
rock_albedo_arr={
"type": "sampler2DArray",
"value": ""
}
rock_nrao_arr={
"type": "sampler2DArray",
"value": ""
}
detail_albedo={
"type": "sampler2DArray",
"value": ""
}
detail_nrao={
"type": "sampler2DArray",
"value": ""
}
world_masks={
"type": "sampler2D",
"value": ""
}
